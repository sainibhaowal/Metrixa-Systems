# ============================================================================
# METRIXA ENGINE — MULTI-PROVIDER LLM & SEARCH HARNESS CONFIGURATION
# ============================================================================

# --- PRIMARY LLM SELECTION ---
# Options: auto_fallback | deepseek | gemini | nvidia_nim | local_llamacpp | lm_studio | deterministic
DEFAULT_LLM_PROVIDER=auto_fallback

# --- 1. LOCAL MODELS (llama.cpp Server / LM Studio) ---
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1
LLAMACPP_MODEL=qwen2.5-14b-instruct
LLAMACPP_API_KEY=local-no-key

LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=local-model
LMSTUDIO_API_KEY=lm-studio

# --- 2. CLOUD LLM APIS (DeepSeek / NVIDIA NIM / Google Gemini) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.3-70b-instruct

GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

# --- 3. SEARCH HARNESS (Local SearXNG + Native Meta-Search + Tavily Fallback) ---
SEARXNG_BASE_URL=http://127.0.0.1:8888
ENABLE_NATIVE_METASEARCH=true
TAVILY_API_KEY=
TAVILY_MAX_CALLS_PER_RUN=400

# --- 4. CRAWLER & DATABASE PERFORMANCE SETTINGS ---
DATABASE_PATH=data/metrixa_leads.db
EXPORT_DIR=data/exports
MAX_CONCURRENT_CRAWLS=20
MAX_SUBPAGES_PER_COMPANY=5
HTTP_TIMEOUT_SECONDS=15
ENABLE_DNS_MX_CHECK=true
